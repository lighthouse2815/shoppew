# Development-only defaults. Copy to .env and replace every secret outside local development.
COMPOSE_PROJECT_NAME=shoppew

POSTGRES_DB=shoppew
POSTGRES_USER=shoppew
POSTGRES_PASSWORD=shoppew_dev_password
POSTGRES_PORT=15432

REDIS_PORT=16379

MINIO_ROOT_USER=shoppew_minio
MINIO_ROOT_PASSWORD=shoppew_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=shoppew-media

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

BACKEND_PORT=28080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
APP_ACCESS_TOKEN_TTL=PT15M
APP_REFRESH_TOKEN_TTL=P30D
APP_INVENTORY_RESERVATION_TTL=PT15M
APP_MOCK_PAYMENT_ENABLED=true
APP_MOCK_PAYMENT_WEBHOOK_SECRET=shoppew-development-mock-webhook-secret-change-before-production
APP_RATE_LIMIT_ENABLED=true
APP_PLATFORM_FEE_RATE=0.05
APP_TIME_ZONE=Asia/Ho_Chi_Minh
APP_JWT_SECRET=shoppew-development-signing-secret-change-before-production-2026
APP_SECURE_COOKIES=false
APP_EMAIL_VERIFICATION_REQUIRED=false
APP_EMAIL_DELIVERY_ENABLED=true
APP_EMAIL_FROM=no-reply@shoppew.local
APP_WEB_BASE_URL=http://localhost:3000
APP_EMAIL_VERIFICATION_TTL=PT24H
APP_PASSWORD_RESET_TTL=PT30M

STOREFRONT_PORT=3000
SELLER_PORT=3001
ADMIN_PORT=3002
