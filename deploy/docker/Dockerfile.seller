# syntax=docker/dockerfile:1.7
ARG VITE_API_URL

FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/storefront/package.json web/storefront/package.json
COPY web/seller/package.json web/seller/package.json
COPY web/admin/package.json web/admin/package.json
COPY web/packages/api-client/package.json web/packages/api-client/package.json
COPY web/packages/ui/package.json web/packages/ui/package.json
RUN pnpm install --frozen-lockfile

COPY web web
COPY scripts/ci/assert-https-origins.mjs scripts/ci/assert-https-origins.mjs
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN node scripts/ci/assert-https-origins.mjs VITE_API_URL \
    && pnpm --filter @shoppew/seller build

FROM nginxinc/nginx-unprivileged:1.30.4-alpine-slim AS runtime
ARG VITE_API_URL
ENV SHOPPEW_API_ORIGIN=${VITE_API_URL}
COPY deploy/nginx/spa.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build --chown=101:101 /workspace/web/seller/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
