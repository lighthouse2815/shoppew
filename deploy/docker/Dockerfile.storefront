# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/storefront/package.json web/storefront/package.json
COPY web/seller/package.json web/seller/package.json
COPY web/admin/package.json web/admin/package.json
COPY web/packages/api-client/package.json web/packages/api-client/package.json
COPY web/packages/ui/package.json web/packages/ui/package.json
RUN pnpm install --frozen-lockfile

COPY web web
COPY scripts/ci/assert-https-origins.mjs scripts/ci/assert-https-origins.mjs

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MEDIA_ORIGIN
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_MEDIA_ORIGIN=${NEXT_PUBLIC_MEDIA_ORIGIN} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN node scripts/ci/assert-https-origins.mjs \
      NEXT_PUBLIC_API_URL NEXT_PUBLIC_MEDIA_ORIGIN NEXT_PUBLIC_SITE_URL \
    && pnpm --filter @shoppew/storefront build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /workspace/web/storefront/.next/standalone ./
COPY --from=build --chown=node:node /workspace/web/storefront/.next/static ./web/storefront/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "web/storefront/server.js"]
